# App Configuration
APP_NAME="Go Backend Template API"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_URL=http://localhost:8000
APP_DEBUG=false
APP_REQUEST_TIMEOUT=10s
APP_SHUTDOWN_TIMEOUT=10s
APP_SHUTDOWN_WAIT=200ms
APP_PROMETHEUS=false
APP_RATE_LIMIT_PER_SECOND=20
APP_RATE_LIMIT_IP_PER_SECOND=200
APP_PUBLIC_API_KEY=

# DB Connection
DB_DRIVER=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=
DB_SSLMODE=disable
DB_MAX_OPEN_CONN=20
DB_MAX_IDLE_CONN=10
DB_MAX_LIFETIME_CONN=10m
DB_MAX_CONN_IDLE_TIME=5m
DB_KEEP_ALIVE_INTERVAL_CONN=5m

# Auth Option
AUTH_ACCESS_TOKEN_SECRET_KEY=secret-key
AUTH_ACCESS_TOKEN_EXPIRES=24h
AUTH_REFRESH_TOKEN_SECRET_KEY=secret-key
AUTH_REFRESH_TOKEN_EXPIRES=48h
AUTH_BCRYPT_COST=10

# Swagger
SWAGGER_ENABLED=true
SWAGGER_HOST=localhost:8000
SWAGGER_BASE_PATH=/api/v1
# Comma-separated service names. Leave empty to include all services.
SWAGGER_SERVICES=
